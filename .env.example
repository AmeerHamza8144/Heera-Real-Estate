# Public canonical URL, without a trailing slash
HEERA_SITE_URL=https://example.com
HEERA_SITE_NAME=Heera Estate
HEERA_PHONE=+923000660446

# Google integrations (leave empty until configured)
HEERA_GOOGLE_SITE_VERIFICATION=
HEERA_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Comma-separated Facebook, Instagram and other official profile URLs
HEERA_SOCIAL_URLS=

HAVENLY_DB_HOST=127.0.0.1
HAVENLY_DB_NAME=havenly_real_estate
HAVENLY_DB_USER=root
HAVENLY_DB_PASSWORD=

# Optional Agent AI Property Advisor. Leave OPENAI_API_KEY empty for local smart matching.
OPENAI_API_KEY=
HEERA_AI_ADVISOR_ENABLED=1
HEERA_AI_ADVISOR_MODEL=gpt-5.6-luna

# Optional public AI Property Comparison. Uses local comparison when disabled or no API key is set.
HEERA_AI_COMPARISON_ENABLED=1
# Leave blank to inherit HEERA_AI_ADVISOR_MODEL.
HEERA_AI_COMPARISON_MODEL=
